<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- make autostart: run the lintel host at login. @BIN@ is replaced by the absolute path of the release build. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.vulca.lintel</string>
	<key>ProgramArguments</key>
	<array>
		<string>@BIN@</string>
		<string>host</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<false/>
</dict>
</plist>
